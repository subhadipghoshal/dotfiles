# ~/.zshrc — interactive shell setup.
#
# Structure (mirrors ~/.config/tmux/, same philosophy):
#   this file          bootstrap only — oh-my-zsh, then the module loop, then
#                      the third-party `eval "$(... init)"` blocks that insist
#                      on running late.
#   ~/.zsh/[0-8]*.zsh  the actual configuration, one concern per file.
#   ~/.zsh/99-agent-guard.zsh   sourced explicitly at the very bottom.
#   ~/.zsh/README.md   why each module exists.

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export PATH=/opt/homebrew/bin:/opt/homebrew/opt/libpq/bin:$HOME/.local/bin:$PATH
export ZSH="$HOME/.oh-my-zsh"
export LANG="en_US.UTF-8"
export LC_CTYPE="en_US.UTF-8"

ZSH_THEME="powerlevel10k/powerlevel10k"

# Case-insensitive completion with - and _ interchangeable.
HYPHEN_INSENSITIVE="true"

zstyle ':omz:update' mode auto      # update automatically without asking

COMPLETION_WAITING_DOTS="true"

# ENABLE_CORRECTION is deliberately NOT set. oh-my-zsh maps it to `correct_all`,
# not `correct` — that spellchecks every ARGUMENT against 585 aliases and 2,341
# functions, exempting only 6 commands. With `bootdev run <exercise>` at 506
# uses it was a constant source of unwanted [nyae] prompts.

# forgit loads after git and unconditionally overwrites 16 oh-my-zsh git
# aliases — ga, gd, gco, gsw, gbd, gbl, glo, grh, grs, gcf, gcb, gclean, gss,
# gcp, grb, gwt — replacing them with interactive fzf pickers that take a fuzzy
# query rather than git arguments. History shows this silently breaking real
# commands after the 2025-12-14 clone: `gco --theirs customers/all.csv`,
# `gd HEAD~1 > commit_n.diff`, `gbl dot_zshrc` eight times in one day.
# This keeps the forgit::* functions available while leaving the aliases alone.
# MUST be set before oh-my-zsh sources the plugin.
export FORGIT_NO_ALIASES=1

# zsh-autosuggestions tuning. All three must be set before the plugin loads.
#   MANUAL_REBIND   without it the plugin re-binds every widget on EVERY precmd
#                   (467 -> 666 widgets), which measured 21.2ms per prompt —
#                   the single largest per-prompt cost in this config.
#   USE_ASYNC       redundant but kept explicit. The plugin tests it with
#                   (( ${+ZSH_AUTOSUGGEST_USE_ASYNC} )) — i.e. "is it SET",
#                   not "is it true" — and start.zsh:29 already sets it to the
#                   empty string by default. So async was ALREADY on; an
#                   earlier reading of this as "empty means off" was backwards.
#   BUFFER_MAX_SIZE unset meant it searched history even on 200-char lines.
ZSH_AUTOSUGGEST_MANUAL_REBIND=1
ZSH_AUTOSUGGEST_USE_ASYNC=1
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20

#
# fzf-tab must load AFTER compinit (oh-my-zsh runs it at line 129) and BEFORE
# any plugin that wraps ZLE widgets — zsh-autosuggestions and F-Sy-H both do.
# Its position in this array is load-bearing; do not sort this list.
plugins=(
  git
  forgit
  fzf-tab
  zsh-autosuggestions
  F-Sy-H
  python
  uv
  docker
  kubectl
  helm
  aliases
  chezmoi
  golang
  tmux
  vi-mode
  codex
)
# Note: fzf is set up manually below (guarded, with the upstream `fzf --zsh`
# integration) instead of via the oh-my-zsh `fzf` plugin, so we control when
# and how it loads.

ZSH_DISABLE_COMPFIX=true

source $ZSH/oh-my-zsh.sh

# ── Modules ───────────────────────────────────────────────────────────────
# Everything real lives in ~/.zsh/. Loaded after oh-my-zsh so these win any
# conflict: our zstyles override omz's, our bindkeys land after the vi-mode
# plugin's `bindkey -v`, and our HISTSIZE/SAVEHIST override lib/history.zsh.
#
# ${ZDOTDIR:-$HOME} rather than $HOME so ~/.config/zsh-sandbox can run this
# same file against its own copy of the modules.
for _zf in ${ZDOTDIR:-$HOME}/.zsh/[0-8]*.zsh(N); do
  source $_zf
done
unset _zf

export EDITOR='nvim'
export ARCHFLAGS="-arch arm64"

# fzf: modern upstream integration (replaces the old key-bindings.zsh /
# completion.zsh dance, which threw a benign "can't change option: zle"
# error on every shell start under fzf 0.74). Stderr is suppressed for the
# same reason. Loads after the modules so it wins ^R and ^T in both keymaps.
if command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --zsh 2>/dev/null)" 2>/dev/null
fi

# Atuin — history in SQLite with exit code, duration and cwd per command.
# MUST come after the fzf block: both bind ^R, and the last one to bind wins.
# --disable-up-arrow leaves Up (and vicmd k) to zsh's own history, which is
# what you actually want with vi mode; ^R is the one that should be Atuin.
# Config, including the enter_accept=false safety, is in ~/.config/atuin/config.toml.
command -v atuin >/dev/null && eval "$(atuin init zsh --disable-up-arrow)"

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Initialize zoxide (authoritative)
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# Init goenv
export GOENV_DISABLE_GOPATH=1
command -v goenv >/dev/null && eval "$(goenv init -)"

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/Users/subhadip/Downloads/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/subhadip/Downloads/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/Users/subhadip/Downloads/google-cloud-sdk/completion.zsh.inc' ]; then . '/Users/subhadip/Downloads/google-cloud-sdk/completion.zsh.inc'; fi

# Generated for envman. Do not edit.
[ -s "$HOME/.config/envman/load.sh" ] && source "$HOME/.config/envman/load.sh"

. "$HOME/.turso/env"

# bun completions
[ -s "/Users/subhadip/.bun/_bun" ] && source "/Users/subhadip/.bun/_bun"

export PATH="/Users/subhadip/.local/bin:$PATH"

# >>> portable-secrets >>>
# Shell integration only; secret values stay in pass and project .envrc files.
# GPG_TTY is set in ~/.zsh/00-options.zsh from $TTY (no fork).
if [[ -o interactive ]]; then
  eval "$(direnv hook zsh)"
fi
# <<< portable-secrets <<<

#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

# Added by LM Studio CLI (lms)
export PATH="$PATH:/Users/subhadip/.lmstudio/bin"
# End of LM Studio CLI section

# PATH is deduplicated automatically: `typeset -U path PATH` in ~/.zshenv is
# read by every shell, so the two manual `path=("${(u)path[@]}")` passes that
# used to sit here and after sdkman are no longer needed.

# ── Agent guard — MUST BE LAST ────────────────────────────────────────────
# Runs after every alias in this file exists, including sdkman's and the
# oh-my-zsh tmux plugin's, because its job is to remove the ones that hang a
# shell no human is watching. See the file for the reproduced failures.
source ${ZDOTDIR:-$HOME}/.zsh/99-agent-guard.zsh
