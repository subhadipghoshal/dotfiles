
# `typeset -U path PATH fpath cdpath manpath` deliberately lives in ~/.zshenv,
# NOT here. .zprofile is only read by LOGIN shells, so when the dedupe was here
# a plain `zsh` produced a differently-hashed fpath and oh-my-zsh deleted the
# compdump on every non-login shell. See ~/.zshenv for the full explanation.

eval "$(/opt/homebrew/bin/brew shellenv)"

# Created by `pipx` on 2025-10-17 14:38:51
export PATH="$PATH:$HOME/.local/bin"

export VISUAL="nvim"

typeset _zsh_agent_behavior
if [[ ${ZSH_AGENT_MODE:-} == 0 ]]; then
  # Keep the override in this shell, but do not pass it to bare agent children.
  typeset +x ZSH_AGENT_MODE
fi

if [[ ! -o interactive || ! -t 1 ]]; then
  _zsh_agent_behavior=agent
else
  case ${ZSH_AGENT_MODE:-} in
    1)
      _zsh_agent_behavior=agent
      ;;
    0)
      _zsh_agent_behavior=human
      ;;
    *)
      if [[ -n ${CLAUDECODE:-} || -n ${CI:-} || -n ${CODEX_SANDBOX:-} \
            || -n ${CURSOR_AGENT:-} || -n ${OPENCODE:-} ]]; then
        _zsh_agent_behavior=agent
      else
        _zsh_agent_behavior=human
      fi
      ;;
  esac
fi

if [[ $_zsh_agent_behavior == human ]]; then
  export PAGER=less
  export MANPAGER="sh -c 'col -bx | bat --theme=default -l man --style=plain --color=always --paging=auto'"
  unset GIT_PAGER DELTA_PAGER
  export LESS=-R
else
  export PAGER=cat
  export MANPAGER=cat
  export GIT_PAGER=cat
  export DELTA_PAGER=cat
  export LESS=-FRX
fi
unset _zsh_agent_behavior
export CFLAGS="-I/opt/homebrew/include -I/opt/homebrew/include/SDL2"
# /opt/homebrew/lib/cmake and .../pkgconfig contain zero .dylib/.a files —
# verified — so passing them to every link was pure noise.
export LDFLAGS="-L/opt/homebrew/lib"
# PKG_CONFIG_PATH was set to exactly /opt/homebrew/lib/pkgconfig, which
# pkg-config already searches by default, while SHADOWING the 186 keg-only
# .pc directories under /opt/homebrew/opt/*/lib/pkgconfig (openssl, libpq,
# icu4c). Classic "configure can't find X". Left unset on purpose.
# export LDFLAGS="-L/opt/homebrew/opt/libpq/lib"
# export CPPFLAGS="-I/opt/homebrew/opt/libpq/include"
export PYTHON_AUTO_VRUN=true
export PYTHON_VENV_NAME=".venv"
export EXPAND_ALIASES=false
# The --preview here used to be global, so it applied to EVERY fzf invocation
# including Ctrl-R, where {} is a command string rather than a filename — the
# history preview pane had been rendering bat errors. File previews now belong
# to the widgets that actually select files.
export FZF_DEFAULT_OPTS="--layout=reverse --border --cycle --wrap --height=60%"
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers {} 2>/dev/null || eza -1 --color=always {}' --preview-window right:70%"
export FZF_ALT_C_OPTS="--preview 'eza -1 --icons --color=always {}' --preview-window right:50%"
export FZF_CTRL_R_OPTS="--preview 'echo {}' --preview-window down:3:hidden:wrap --bind '?:toggle-preview'"

# GO ENV
export GOENV_ROOT="$HOME/.goenv"
export GOENV_DISABLE_GOPATH=1
export PATH="$GOENV_ROOT:$PATH"

export GOPATH="$HOME/go"
export GOBIN="$GOPATH/bin"
export PATH="$PATH:$GOBIN"

# rbenv: shims on PATH statically instead of `eval "$(rbenv init -)"`.
# Measured in the sandbox, median-of-10 startup: 300 ms with the eval, 260 ms
# without it. (The 140 ms figure previously recorded in ~/.zsh/README.md was
# the cost of running `rbenv init` as its own process, not its marginal cost
# inside startup.) The eval emits exactly 16 lines: the shims PATH entry,
# RBENV_SHELL, and a dispatch function — none needed until `rbenv` is run.
# `ruby` and `gem` resolve through the shims with no init, and Ruby is
# near-unused here: 1 `ruby` in 6,950 recorded commands.
#
# NOTE: .zshrc prepends /opt/homebrew/bin after this file runs, so the shims
# sit behind Homebrew and `ruby` resolves to /opt/homebrew/bin/ruby either
# way. That is pre-existing and unchanged by this block.
export RBENV_ROOT="$HOME/.rbenv"
export PATH="$RBENV_ROOT/shims:$PATH"

rbenv() {
  unset -f rbenv
  eval "$(command rbenv init - --no-rehash zsh)"
  rbenv "$@"
}

# Docker Desktop's CLI completions and ~/.zfunc are both on fpath, but they are
# declared in ~/.zshenv rather than here. .zprofile is login-only, and a
# login-only fpath entry makes oh-my-zsh delete and rebuild the compdump on
# every non-login shell — a tmux pane, or a bare `zsh`. See ~/.zshenv.

# Added by Windsurf
export PATH="$HOME/.codeium/windsurf/bin:$PATH"

# compinit runs once, later, via oh-my-zsh in .zshrc — it picks up everything
# added to fpath in ~/.zshenv, so no need to call it here (was running 3x per
# shell start before this cleanup).

# Added by Antigravity
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Added by Antigravity CLI installer
export PATH="$HOME/.local/bin:$PATH"
