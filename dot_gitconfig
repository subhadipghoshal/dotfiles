[color]
    ui = true

[core]
    pager = delta

[pager]
    diff = delta
    show = delta

[delta]
    side-by-side = true
    line-numbers = true
    navigate = true

[interactive]
    diffFilter = delta --color-only --side-by-side

[user]
    name = Subhadip Ghoshal
    email = sghoshal.tech@gmail.com

[commit]
    gpgsign = true

[include]
    path = ~/.gitconfig.local

[pull]
    rebase = true

[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://github.docusignhq.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
