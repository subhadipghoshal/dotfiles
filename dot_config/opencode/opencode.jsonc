{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "model": "{env:OPENCODE_MODEL_DEFAULT}",
  "provider": {},
  "agent": {
    // Machine-specific model selection: each slot reads an {env:...} reference
    // resolved from ~/.config/opencode/env (machine-local, not chezmoi-tracked).
    "plan": { "model": "{env:OPENCODE_MODEL_PLAN}" },
    "build": { "model": "{env:OPENCODE_MODEL_BUILD}" },
    "goal": { "model": "{env:OPENCODE_MODEL_GOAL}" },
  },
  "instructions": [
    "https://raw.githubusercontent.com/JRedeker/opencode-shell-strategy/trunk/shell_strategy.md",
  ],
  "plugin": [
    "opencode-openai-codex-auth",
    "opencode-vibeguard",
    "opencode-antigravity-auth",
    "opencode-gemini-auth@latest",
    "opencode-model-router",
    "opencode-anthropic-fix",
    "@tarquinen/opencode-dcp",
    "opencode-pty",
    "@plannotator/opencode",
    "opencode-goal-plugin",
    "@zenobius/opencode-skillful",
    "opencode-websearch-cited",
    "opencode-supermemory",
    "opencode-notify",
  ],
}
